# ===================================================
# C / C++ (GCC, Clang, MSVC)
# ===================================================
# Исполняемые файлы
*.exe
*.out
*.app

# Объектные файлы и промежуточные сборки
*.o
*.obj
*.slo
*.lo
*.d
*.gch
*.pch

# Отладочные и компоновочные файлы
*.ilk
*.pdb
*.dwo

# Библиотеки
*.lib
*.a
*.la
*.lai
*.so
*.dylib
*.dll

# Папки сборки и кэш компиляторов
build/
Build/
build-*/
bin/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
.cache/

# ===================================================
# Python
# ===================================================
# Байткод и кэш
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения
venv/
.venv/
env/
ENV/

# Кэш тестов и линтеров
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Переменные окружения и секреты
.env

# ===================================================
# IDE и редакторы
# ===================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
.vs/
*.swp
*.bak
*.tmp

# ===================================================
